# --- Portable mount banner (Linux + macOS), bash & zsh-safe ------------------
# Notes:
# - Does not rely on `uname`; uses feature detection and/or $OSTYPE.
# - Uses `mountpoint` when present; falls back to stat device id comparison.
# - df -hP for consistent parsing; prints "X used / Y free".
# - In zsh, refresh command hash in case PATH changed during init.

# zsh: refresh command hash so previously-missed commands are found now
# [ -n "${ZSH_VERSION-}" ] && rehash

have() { command -v "$1" >/dev/null 2>&1; }

is_mountpoint() {
  # Return 0 if $1 is a mount point.
  # 1) Fast path: Linux mountpoint(1)
  if have mountpoint; then
    mountpoint -q -- "$1" 2>/dev/null && return 0 || return 1
  fi

  # 2) Fallback: compare device IDs of path vs its parent using stat
  # Detect BSD vs GNU stat by trying BSD's -f first.
  [ -e "$1" ] || return 1
  parent=$(dirname -- "$1")

  if stat -f %d / >/dev/null 2>&1; then
    # BSD/macOS stat
    d1=$(stat -f %d -- "$1" 2>/dev/null)    || return 1
    d2=$(stat -f %d -- "$parent" 2>/dev/null) || return 1
  else
    # GNU/busybox stat
    d1=$(stat -c %d -- "$1" 2>/dev/null)    || return 1
    d2=$(stat -c %d -- "$parent" 2>/dev/null) || return 1
  fi

  [ "$d1" != "$d2" ]
}

disk_usage_human() {
  # Prints "X used / Y free" for $1
  # -P makes df output POSIX-like (one line per mount)
  df -hP -- "$1" 2>/dev/null | awk 'NR==2 {print $3 " used / " $4 " free"}'
}

print_mount_status() {
  local name="$1";
  local _path="$2"
  local icon_ok=""     # Nerd Font (fallback to ✔ if your font lacks it)
  local icon_err=""    # Nerd Font (fallback to ✖)

  if is_mountpoint "$_path"; then
    info=$(disk_usage_human "$_path")
    # green "Mounted" + cyan disk info
    printf "  \033[32m%s\033[0m %-10s - \033[32mMounted\033[0m (\033[36m%s\033[0m)\n" "$icon_ok" "$name" "${info:-N/A}"
  else
    printf "  \033[31m%s\033[0m %-10s - \033[31mNot Mounted\033[0m\n" "$icon_err" "$name"
  fi
}

# Only on interactive shells and when stdout is a TTY
case $- in *i*)
  [ -t 1 ] && {
    printf "💾 \033[1mMounts Status:\033[0m\n"
    print_mount_status "Gigachad" "/mnt/gigachad"
    print_mount_status "Terachad" "/mnt/terachad"
    print_mount_status "external" "/mnt/2f6b0ef2-2505-422b-a2f3-ecdad0b2b6c6"
    printf "\n"
  }
esac
